const SPREADSHEET_ID = 'PASTE_YOUR_GOOGLE_SHEET_ID_HERE';
const SHEET_NAME = 'RD_Data';
const HEADERS = ['id','bank','accountNumber','monthlyAmount','startDate','closingDate','termMonths','installmentsPaid','dueDay','maturityAmount','notes','payments','createdAt'];
function doGet(){try{const sh=sheet_(),v=sh.getDataRange().getValues(),h=(v.shift()||[]).map(String);return out_({ok:true,records:v.filter(r=>r.some(x=>x!==''&&x!=null)).map(r=>read_(h,r)).filter(Boolean)});}catch(e){return out_({ok:false,error:String(e),records:[]});}}
function doPost(e){const lock=LockService.getScriptLock();try{lock.waitLock(20000);const b=JSON.parse(e&&e.postData&&e.postData.contents||'{}');if(!Array.isArray(b.records))throw Error('Expected records array');const sh=sheet_(),v=sh.getDataRange().getValues(),h=v[0].map(String),byId={},byKey={};v.slice(1).forEach((row,i)=>{const r=read_(h,row);if(r){if(r.id)byId[r.id]=i+2;byKey[key_(r)]=i+2;}});let inserted=0,updated=0;b.records.forEach(raw=>{const r=norm_(raw);if(!r.bank||!r.startDate)return;const at=byId[r.id]||byKey[key_(r)];const row=at?sh.getRange(at,1,1,h.length).getValues()[0]:Array(h.length).fill('');h.forEach((col,j)=>{const k=field_(col);if(k&&Object.prototype.hasOwnProperty.call(r,k))row[j]=k==='payments'?JSON.stringify(r.payments):r[k];});if(at){sh.getRange(at,1,1,h.length).setValues([row]);updated++;}else{sh.appendRow(row);const n=sh.getLastRow();byId[r.id]=n;byKey[key_(r)]=n;inserted++;}});return out_({ok:true,inserted,updated,total:sh.getLastRow()-1});}catch(e){return out_({ok:false,error:String(e)});}finally{try{lock.releaseLock();}catch(_){}}}
function sheet_(){if(SPREADSHEET_ID==='PASTE_YOUR_GOOGLE_SHEET_ID_HERE')throw Error('Set SPREADSHEET_ID in the script first.');const ss=SpreadsheetApp.openById(SPREADSHEET_ID);let sh=ss.getSheetByName(SHEET_NAME);if(!sh)sh=ss.insertSheet(SHEET_NAME);if(!sh.getLastRow())sh.getRange(1,1,1,HEADERS.length).setValues([HEADERS]);let h=sh.getRange(1,1,1,sh.getLastColumn()).getValues()[0].map(String);HEADERS.forEach(x=>{if(!h.some(y=>field_(y)===field_(x))){h.push(x);sh.getRange(1,h.length).setValue(x);}});return sh;}
function read_(h,row){const g=(...names)=>{const i=h.findIndex(x=>names.map(norm_).includes(norm_(x)));return i<0?'':row[i];};let p=g('payments','paymentHistory');if(typeof p==='string'){try{p=JSON.parse(p);}catch(e){p=[];}}if(!Array.isArray(p))p=[];const bank=String(g('bank','bankName','institution','postOffice','name','rdName','nameOfTheDepositor','depositorName')||'').trim();if(!bank)return null;const accountNumber=String(g('accountNumber','account','nickname','rdNumber','newNoOfAccount')||'').trim(),startDate=date_(g('startDate','start','openingDate','dateOfOpening','rdStartDate')),closingDate=date_(g('closingDate','dateOfClosing','maturityDate','closeDate')),monthlyAmount=Number(g('monthlyAmount','monthlyInstallment','monthlyInstalment','amount','rdAmount','amountDeposited','monthly'))||0;const months=startDate&&closingDate?Math.max(1,(+closingDate.slice(0,4)- +startDate.slice(0,4))*12+(+closingDate.slice(5,7)- +startDate.slice(5,7))):60;return norm_({id:String(g('id','recordId','rdId')||stable_(bank,accountNumber,startDate,monthlyAmount)),bank,accountNumber,monthlyAmount,startDate,closingDate,termMonths:Number(g('termMonths','durationMonths','tenureMonths','duration'))||months,installmentsPaid:Number(g('installmentsPaid','paidInstallments','paid'))||p.length,dueDay:Number(g('dueDay','paymentDay'))||5,maturityAmount:g('maturityAmount','targetAmount','goal')||monthlyAmount*months,notes:String(g('notes','remarks')||''),payments:p,createdAt:String(g('createdAt')||'')});}
function norm_(r){let p=Array.isArray(r.payments)?r.payments:[];if(typeof r.payments==='string'){try{p=JSON.parse(r.payments);}catch(e){p=[];}}const bank=String(r.bank||r.bankName||r.name||'').trim(),accountNumber=String(r.accountNumber||r.account||'').trim(),startDate=date_(r.startDate||r.start||r.openingDate),closingDate=date_(r.closingDate||r.dateOfClosing||''),monthlyAmount=Number(r.monthlyAmount??r.monthly)||0;return {id:String(r.id||stable_(bank,accountNumber,startDate,monthlyAmount)),bank,accountNumber,monthlyAmount,startDate,closingDate,termMonths:Math.max(1,Number(r.termMonths??r.duration)||60),installmentsPaid:Math.max(0,Number(r.installmentsPaid??r.paid)||0),dueDay:Math.min(31,Math.max(1,Number(r.dueDay)||5)),maturityAmount:Number(r.maturityAmount??r.goal)||monthlyAmount*(Number(r.termMonths??r.duration)||60),notes:String(r.notes||''),payments:p,createdAt:String(r.createdAt||new Date().toISOString())};}
function date_(v){if(v instanceof Date&&!isNaN(v))return Utilities.formatDate(v,Session.getScriptTimeZone(),'yyyy-MM-dd');if(!v)return '';let s=String(v).trim(),m=s.match(/^(\d{1,2})[.\/-](\d{1,2})[.\/-](\d{2}|\d{4})$/);if(m){let y=+m[3];if(y<100)y+=y>=50?1900:2000;return y+'-'+('0'+m[2]).slice(-2)+'-'+('0'+m[1]).slice(-2);}m=s.match(/^(\d{4})[-/](\d{1,2})[-/](\d{1,2})$/);return m?m[1]+'-'+('0'+m[2]).slice(-2)+'-'+('0'+m[3]).slice(-2):'';}
function norm(s){return String(s||'').toLowerCase().replace(/[^a-z0-9]/g,'');}
function field_(h){const n=norm(h),a={id:['id','recordid','rdid'],bank:['bank','bankname','institution','postoffice','name','rdname','nameofthedepositor','depositorname'],accountNumber:['accountnumber','account','nickname','rdnumber','newnoofaccount'],monthlyAmount:['monthlyamount','monthlyinstallment','monthlyinstalment','amount','rdamount','amountdeposited','monthly'],startDate:['startdate','start','openingdate','dateofopening','rdstartdate'],closingDate:['closingdate','dateofclosing','maturitydate','closedate'],termMonths:['termmonths','durationmonths','tenuremonths','duration'],installmentsPaid:['installmentspaid','paidinstallments','paid'],dueDay:['dueday','paymentday'],maturityAmount:['maturityamount','targetamount','goal'],notes:['notes','remarks'],payments:['payments','paymenthistory'],createdAt:['createdat']};for(const k in a)if(a[k].includes(n))return k;return '';}
function key_(r){return [r.bank.toLowerCase().trim(),r.accountNumber.toLowerCase().trim(),r.startDate,Number(r.monthlyAmount)||0].join('|');}
function stable_(b,a,s,m){return 'rd-'+Utilities.base64EncodeWebSafe([b,a,s,m].join('|')).replace(/=+$/,'').slice(0,45);}
function out_(v){return ContentService.createTextOutput(JSON.stringify(v)).setMimeType(ContentService.MimeType.JSON);}
